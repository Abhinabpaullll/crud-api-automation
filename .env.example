# ==============================================================================
# Environment Configuration Template
# Project: CRUD API Automation and Validation Framework
#
# Instructions:
# 1. Copy this file to '.env' before starting the application:
#    cp .env.example .env     (Linux/macOS)
#    copy .env.example .env   (Windows Command Prompt)
#    Copy-Item .env.example .env (Windows PowerShell)
# 2. Adjust values as needed. Default values allow running out of the box with
#    in-memory storage without any database setup.
# 3. NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Server Port
# The HTTP port on which the Express API server listens.
# Default: 5000
PORT=5000

# MongoDB Connection String (Optional)
# - Leave blank/unset to use the built-in fast In-Memory repository.
# - Provide a valid URI to enable persistent storage via MongoDB / Mongoose.
# Example: mongodb://localhost:27017/student_db
# Example: mongodb://127.0.0.1:27017/student_db
MONGODB_URI=

# Enable Test Support Routes
# Enables test-only administrative endpoints:
#   - POST /api/test/reset (clears all student records between test runs)
# Set to 'true' for local testing and automated Newman CI runs.
# Set to 'false' (or leave unset) for production or standard operation.
# Default: false
ENABLE_TEST_ROUTES=false

# Fault Injection for Mutation Testing (Demonstration Only)
# Used in Stage 4 testing to verify that automated tests detect API defects.
# Leave unset or empty for normal operation.
# Supported values (defined in docs/test-matrix.md):
#   - delete-returns-200          (Bug B01: DELETE returns 200 with body instead of 204)
#   - skip-email-validation       (Bug B02: Accepts malformed email strings)
#   - skip-unique-email           (Bug B03: Allows duplicate emails in memory mode)
#   - year-upper-bound-5          (Bug B04: Accepts student year 5)
#   - wrong-content-type          (Bug B09: Returns text/html instead of application/json)
# Default: unset / empty
INJECT_BUG=
