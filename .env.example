# Server configuration
PORT=5000

# MongoDB connection string (leave empty or unset to use in-memory store)
MONGODB_URI=

# Enable test reset endpoint (POST /api/test/reset)
ENABLE_TEST_ROUTES=false

# Deliberate Stage 4 mutation for demonstrations only; leave empty normally.
# Values are listed in docs/test-matrix.md. Never set this in normal CI.
INJECT_BUG=

