# Server Port (default: 5000)
PORT=5000

# MongoDB URI (leave unset or empty to fall back to in-memory store)
MONGODB_URI=

# Enable test support routes (POST /api/test/reset)
ENABLE_TEST_ROUTES=false

# Deliberate fault injection for Stage 4 demonstrations; leave unset normally.
# Known values are listed in docs/test-matrix.md. Never enable in normal CI.
INJECT_BUG=

