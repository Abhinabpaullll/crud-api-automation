# ==============================================================================
# Environment Configuration Template (Backend)
# Project: CRUD API Automation and Validation Framework
#
# Copy this file to 'backend/.env' if running the backend standalone:
#   copy .env.example .env
# ==============================================================================

# Server Port
PORT=5000

# MongoDB Connection String (Optional)
# Leave empty to use in-memory store.
# Example: mongodb://localhost:27017/student_db
MONGODB_URI=

# Enable Test Reset Route (POST /api/test/reset)
ENABLE_TEST_ROUTES=false

# Fault Injection (Stage 4 only; leave empty for normal operation)
INJECT_BUG=
